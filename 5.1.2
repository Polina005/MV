#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>
#include <iomanip>

using namespace std;

double f(double x) {
    return 1.0 / (1.0 + 25.0 * x * x);
}

double lagrange(const vector<double>& x_nodes, const vector<double>& y_nodes, double x) {
    int n = x_nodes.size();
    double result = 0.0;
    for (int i = 0; i < n; i++) {
        double term = y_nodes[i];
        for (int j = 0; j < n; j++) {
            if (j != i) {
                term *= (x - x_nodes[j]) / (x_nodes[i] - x_nodes[j]);
            }
        }
        result += term;
    }
    return result;
}

vector<double> ravnomernye_uzly(int n, double a, double b) {
    vector<double> nodes(n);
    for (int i = 0; i < n; i++) {
        nodes[i] = a + i * (b - a) / (n - 1);
    }
    return nodes;
}

vector<double> chebyshev_uzly(int n, double a, double b) {
    vector<double> nodes(n);
    for (int i = 0; i < n; i++) {
        double t = cos((2.0 * (n - i) - 1.0) * 3.1415926535 / (2.0 * n));
        nodes[i] = (a + b) / 2.0 + (b - a) / 2.0 * t;
    }
    sort(nodes.begin(), nodes.end());
    return nodes;
}

class CubicSpline {
private:
    vector<double> x, a, b, c, d;
public:
    CubicSpline(const vector<double>& x_nodes, const vector<double>& y_nodes) {
        x = x_nodes;
        int n = x.size();
        a = y_nodes;
        b.resize(n - 1);
        c.resize(n);
        d.resize(n - 1);

        vector<double> h(n - 1);
        for (int i = 0; i < n - 1; i++) h[i] = x[i + 1] - x[i];

        vector<double> alpha(n - 1);
        for (int i = 1; i < n - 1; i++) {
            alpha[i] = (3.0 / h[i]) * (a[i + 1] - a[i]) - (3.0 / h[i - 1]) * (a[i] - a[i - 1]);
        }

        vector<double> l(n), mu(n), z(n);
        l[0] = 1.0; mu[0] = 0.0; z[0] = 0.0;

        for (int i = 1; i < n - 1; i++) {
            l[i] = 2.0 * (x[i + 1] - x[i - 1]) - h[i - 1] * mu[i - 1];
            mu[i] = h[i] / l[i];
            z[i] = (alpha[i] - h[i - 1] * z[i - 1]) / l[i];
        }

        l[n - 1] = 1.0; z[n - 1] = 0.0; c[n - 1] = 0.0;

        for (int i = n - 2; i >= 0; i--) {
            c[i] = z[i] - mu[i] * c[i + 1];
            b[i] = (a[i + 1] - a[i]) / h[i] - h[i] * (c[i + 1] + 2.0 * c[i]) / 3.0;
            d[i] = (c[i + 1] - c[i]) / (3.0 * h[i]);
        }
    }

    double evaluate(double x_val) const {
        int n = x.size();
        if (x_val <= x[0]) {
            double dx = x_val - x[0];
            return a[0] + b[0] * dx + c[0] * dx * dx + d[0] * dx * dx * dx;
        }
        if (x_val >= x[n - 1]) {
            double dx = x_val - x[n - 2];
            return a[n - 2] + b[n - 2] * dx + c[n - 2] * dx * dx + d[n - 2] * dx * dx * dx;
        }
        int i = 0;
        while (i < n - 1 && x_val > x[i + 1]) i++;
        double dx = x_val - x[i];
        return a[i] + b[i] * dx + c[i] * dx * dx + d[i] * dx * dx * dx;
    }
};

double max_pogreshnost_lagrange(const vector<double>& uzly, double a, double b) {
    vector<double> znacheniya;
    for (double x : uzly) znacheniya.push_back(f(x));

    double max_err = 0.0;
    for (int i = 0; i <= 500; i++) {
        double x_val = a + i * (b - a) / 500;
        double exact = f(x_val);
        double interp = lagrange(uzly, znacheniya, x_val);
        double err = fabs(interp - exact);
        if (err > max_err) max_err = err;
    }
    return max_err;
}

double max_pogreshnost_spline(const CubicSpline& spline, double a, double b) {
    double max_err = 0.0;
    for (int i = 0; i <= 500; i++) {
        double x_val = a + i * (b - a) / 500;
        double exact = f(x_val);
        double interp = spline.evaluate(x_val);
        double err = fabs(interp - exact);
        if (err > max_err) max_err = err;
    }
    return max_err;
}

int main() {
    const double a = -1.0, b = 1.0;
    int n_vals[] = { 5, 11, 15 };

    cout << fixed << setprecision(8);
    setlocale(LC_ALL, "Russian");
    // Лагранж с равномерными узлами
    cout << "Лагранж (равномерные узлы) : \n";
        for (int k = 0; k < 3; k++) {
            int n = n_vals[k];
            vector<double> uzly = ravnomernye_uzly(n, a, b);
            double err = max_pogreshnost_lagrange(uzly, a, b);
            cout << "n=" << n << " погрешность=" << err << "\n";
        }

    // Лагранж с узлами Чебышева
    cout << "\nЛагранж (узлы Чебышева):\n";
    for (int k = 0; k < 3; k++) {
        int n = n_vals[k];
        vector<double> uzly = chebyshev_uzly(n, a, b);
        double err = max_pogreshnost_lagrange(uzly, a, b);
        cout << "n=" << n << " погрешность=" << err << "\n";
    }

    // Кубический сплайн
    cout << "\nКубический сплайн (равномерные узлы):\n";
    for (int k = 0; k < 3; k++) {
        int n = n_vals[k];
        vector<double> uzly = ravnomernye_uzly(n, a, b);
        vector<double> znacheniya;
        for (double x : uzly) znacheniya.push_back(f(x));
        CubicSpline spline(uzly, znacheniya);
        double err = max_pogreshnost_spline(spline, a, b);
        cout << "n=" << n << " погрешность=" << err << "\n";
    }

    // Задание 2
    cout << "\nЗадание 2:\n";
    vector<double> x_tab = { 2.0, 3.0, 5.0, 7.0 };
    vector<double> y_tab = { 4.0, -2.0, 6.0, -3.0 };

    CubicSpline spline_tab(x_tab, y_tab);

    cout << "Проверка в узлах:\n";
    for (int i = 0; i < x_tab.size(); i++) {
        cout << "S(" << x_tab[i] << ")=" << spline_tab.evaluate(x_tab[i])
            << " точное=" << y_tab[i] << "\n";
    }

    cout << "\nПромежуточные точки:\n";
    vector<double> test_x = { 2.5, 3.5, 4.0, 4.5, 5.5, 6.0, 6.5 };
    for (double x : test_x) {
        cout << "S(" << x << ")=" << spline_tab.evaluate(x) << "\n";
    }

    return 0;
}
