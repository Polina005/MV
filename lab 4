#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

void jacobi(double A[3][3], double b[3], double epsilon, int maxIter) {
    double x[3] = { 0, 0, 0 };
    double x_new[3];

    cout << "МЕТОД ЯКОБИ\n";

    for (int iter = 1; iter <= maxIter; iter++) {
        // Вычисляем новые значения
        x_new[0] = (b[0] - A[0][1] * x[1] - A[0][2] * x[2]) / A[0][0];
        x_new[1] = (b[1] - A[1][0] * x[0] - A[1][2] * x[2]) / A[1][1];
        x_new[2] = (b[2] - A[2][0] * x[0] - A[2][1] * x[1]) / A[2][2];

        // Вычисляем разницу между новым и старым приближением
        double diff = 0;
        diff = max(diff, fabs(x_new[0] - x[0]));
        diff = max(diff, fabs(x_new[1] - x[1]));
        diff = max(diff, fabs(x_new[2] - x[2]));

        cout << "Итерация " << iter << ": ";
        cout << "x1 = " << fixed << setprecision(6) << x_new[0] << " ";
        cout << "x2 = " << x_new[1] << " ";
        cout << "x3 = " << x_new[2] << " ";
        cout << "разница = " << diff << endl;

        // Копируем новые значения в старые
        x[0] = x_new[0];
        x[1] = x_new[1];
        x[2] = x_new[2];

        // Проверка точности
        if (diff < epsilon) {
            cout << "\nДостигнута точность на итерации " << iter << endl;
            break;
        }
    }

    cout << "\nРешение:\n";
    cout << "x1 = " << x[0] << endl;
    cout << "x2 = " << x[1] << endl;
    cout << "x3 = " << x[2] << endl;
}

// Метод Зейделя
void seidel(double A[3][3], double b[3], double epsilon, int maxIter) {
    double x[3] = { 0, 0, 0 };

    cout << "\nМЕТОД ЗЕЙДЕЛЯ\n";
    cout << "--------------\n";

    for (int iter = 1; iter <= maxIter; iter++) {
        double x_old[3] = { x[0], x[1], x[2] };

        // Вычисляем новые значения (используем уже обновлённые)
        x[0] = (b[0] - A[0][1] * x[1] - A[0][2] * x[2]) / A[0][0];
        x[1] = (b[1] - A[1][0] * x[0] - A[1][2] * x[2]) / A[1][1];
        x[2] = (b[2] - A[2][0] * x[0] - A[2][1] * x[1]) / A[2][2];

        // Вычисляем разницу
        double diff = 0;
        diff = max(diff, fabs(x[0] - x_old[0]));
        diff = max(diff, fabs(x[1] - x_old[1]));
        diff = max(diff, fabs(x[2] - x_old[2]));

        cout << "Итерация " << iter << ": ";
        cout << "x1 = " << fixed << setprecision(6) << x[0] << " ";
        cout << "x2 = " << x[1] << " ";
        cout << "x3 = " << x[2] << " ";
        cout << "разница = " << diff << endl;

        // Проверка точности
        if (diff < epsilon) {
            cout << "\nДостигнута точность на итерации " << iter << endl;
            break;
        }
    }

    cout << "\nРешение:\n";
    cout << "x1 = " << x[0] << endl;
    cout << "x2 = " << x[1] << endl;
    cout << "x3 = " << x[2] << endl;
}

int main() {
    setlocale(LC_ALL, "Russian");

    // Матрица A
    double A[3][3] = {
        { 4, -1,  1},
        { 1,  5, -1},
        { 1, -1, -5}
    };

    // Вектор b
    double b[3] = { 3, 2, 6 };

    double epsilon = 0.001;
    int maxIter = 100;

    cout << "Система уравнений:\n";
    cout << "4x1 - x2 + x3 = 3\n";
    cout << "x1 + 5x2 - x3 = 2\n";
    cout << "x1 - x2 - 5x3 = 6\n\n";

    // Запуск методов
    jacobi(A, b, epsilon, maxIter);
    seidel(A, b, epsilon, maxIter);
}
