#include <iostream>
#include <cmath>
#include <iomanip>
#include <vector>

using namespace std;

const double PI = 3.141592653589793;

double erf_integrand(double t) {
    return exp(-t * t);
}

double pi_integrand(double x) {
    return 4.0 / (1.0 + x * x);
}

double f3(double x) {
    if (x >= 0 && x <= 2) {
        return exp(x);
    }
    else if (x > 2 && x <= 4) {
        return 1.0 / (4.0 - sin(16.0 * PI * x));
    }
    return 0;
}

double rectangle_method(double (*f)(double), double a, double b, int n) {
    double h = (b - a) / n;
    double sum = 0.0;
    for (int i = 0; i < n; i++) {
        double x = a + i * h + h / 2.0;
        sum += f(x);
    }
    return sum * h;
}

double trapezoid_method(double (*f)(double), double a, double b, int n) {
    double h = (b - a) / n;
    double sum = (f(a) + f(b)) / 2.0;
    for (int i = 1; i < n; i++) {
        double x = a + i * h;
        sum += f(x);
    }
    return sum * h;
}

double simpson_method(double (*f)(double), double a, double b, int n) {
    if (n % 2 != 0) n++;  // n должно быть чётным
    double h = (b - a) / n;
    double sum = f(a) + f(b);
    for (int i = 1; i < n; i++) {
        double x = a + i * h;
        if (i % 2 == 0) {
            sum += 2 * f(x);
        }
        else {
            sum += 4 * f(x);
        }
    }
    return sum * h / 3.0;
}

void zadanie1() {
    cout << "\n(1) Функция ошибок erf(x)\n";
    cout << fixed << setprecision(6);
    cout << "   x      erf(x) вычисл.    erf(x) точное     Погрешность\n";
    cout << "-----------------------------------------------------------\n";

    double exact_erf[] = {
        0.000000, 0.112463, 0.222703, 0.328627, 0.428392,
        0.520500, 0.603856, 0.677801, 0.742101, 0.796908,
        0.842701, 0.880205, 0.910314, 0.934008, 0.952285,
        0.965590, 0.974762, 0.981552, 0.986235, 0.989297,
        0.991119
    };

    for (int i = 0; i <= 20; i++) {
        double x = i * 0.1;
        double exact = exact_erf[i];

        int n = 1000;
        double integral = simpson_method(erf_integrand, 0, x, n);
        double computed = (2.0 / sqrt(PI)) * integral;

        double error = fabs(computed - exact);
        cout << setw(5) << x << "   |   " << computed << "   |   " << exact << "   |   " << error << "\n";
    }
}

void zadanie2() {
    cout << "\n(2) Вычисление pi\n";

    int n_values[] = { 8, 32, 128 };
    double exact_pi = PI;

    cout << fixed << setprecision(10);
    cout << "\nМетод прямоугольников\n";
    cout << "   n       pi приближ       Погрешность\n";
    cout << "-------------------------------------\n";
    for (int n : n_values) {
        double pi_rect = rectangle_method(pi_integrand, 0, 1, n);
        double error = fabs(pi_rect - exact_pi);
        cout << setw(5) << n << "   |   " << pi_rect << "   |   " << error << "\n";
    }

    cout << "\nМетод трапеций\n";
    cout << "   n       pi приближ         Погрешность\n";
    cout << "-------------------------------------\n";
    for (int n : n_values) {
        double pi_trap = trapezoid_method(pi_integrand, 0, 1, n);
        double error = fabs(pi_trap - exact_pi);
        cout << setw(5) << n << "   |   " << pi_trap << "   |   " << error << "\n";
    }

    cout << "\nМетод Симпсона\n";
    cout << "   n       pi приближ        Погрешность\n";
    cout << "-------------------------------------\n";
    for (int n : n_values) {
        double pi_simp = simpson_method(pi_integrand, 0, 1, n);
        double error = fabs(pi_simp - exact_pi);
        cout << setw(5) << n << "   |   " << pi_simp << "   |   " << error << "\n";
    }
}

void zadanie3() {
    cout << "\n(3) Интеграл от кусочной функции\n";

    double a = 0, b = 4;
    vector<int> n_values = { 100, 500, 1000, 5000, 10000 };

    cout << fixed << setprecision(10);
    cout << "   n      Метод Симпсона   \n";
    cout << "----------------------------\n";

    double prev_integral = 0;
    for (int n : n_values) {
        double integral = simpson_method(f3, a, b, n);
        double change = fabs(integral - prev_integral);
        cout << setw(5) << n << "   |   " << integral;
        if (prev_integral != 0) {
            cout << "   |   изменение: " << change;
        }
        cout << "\n";
        prev_integral = integral;
    }


    cout << "\nС разбиением в точке x=2\n";
    for (int n : n_values) {
        double integral1 = simpson_method(f3, 0, 2, n / 2);
        double integral2 = simpson_method(f3, 2, 4, n / 2);
        double integral = integral1 + integral2;
        cout << setw(5) << n << "   |   " << integral << "\n";
    }
}

int main() {
    setlocale(LC_ALL, "rus");

    cout << "Методы прямоугольников, трапеций, Симпсона\n";

    zadanie1();
    zadanie2();
    zadanie3();
}
