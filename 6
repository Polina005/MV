#include <iostream>
#include <random>
#include <cmath>
#include <vector>
#include <fstream>
#include <iomanip>

using namespace std;

const int n = 12; 
const int N = 10000; 

double f1(double x) {
    return 10.0 * x / n;
}

double f2(double x) {
    return 10.0 * (20.0 - x) / (20.0 - n)+20.0;
}

double integr(double x) {
    return sqrt(29.0 - n * cos(x) * cos(x));
}

bool inCircle(double x, double y, double R) {
    return (x * x + y * y) <= R * R;
}

double polar(double phi, double A, double B) {
    double cos2 = cos(phi) * cos(phi);
    double sin2 = sin(phi) * sin(phi);
    double denom = A * cos2 + B * sin2;
    if (denom <= 0) return 0;
    return sqrt(denom);
}

int main() {
    setlocale(LC_ALL, "Russian");
    random_device rd;
    mt19937 gen(rd());
    uniform_real_distribution<> dis(0.0, 1.0);

    cout << "задание 1: Площадь между f1(x) и f2(x)" << endl;

    double x_min = 0, x_max = 20;
    double y_min = 0, y_max = 10;
    double ar = (x_max - x_min) * (y_max - y_min); 

    int M1 = 0;
    vector<pair<double, double>> points1;

    for (int i = 0; i < N; i++) {
        double x = x_min + dis(gen) * (x_max - x_min);
        double y = y_min + dis(gen) * (y_max - y_min);

        double low = f1(x);
        double up = f2(x);

        // Корректировка: f1 снизу, f2 сверху при 0 <= x <= 20
        if (x >= 0 && x <= 20) {
            if (y >= low && y <= up) {
                M1++;
                points1.push_back({ x, y });
            }
        }
    }

    double S1 = (double)M1 / N * ar;
    double error1_abs = ar * sqrt((double)M1 / N * (1 - (double)M1 / N) / N);
    double error1_rel = error1_abs / S1 * 100;

    cout << "Площадь фигуры S1 = " << S1 << endl;
    cout << "Попало точек: " << M1 << " из " << N << endl;
    cout << "Абсолютная погрешность: ~" << error1_abs << endl;
    cout << "Относительная погрешность: ~" << error1_rel << "%" << endl << endl;

    cout << "задание 2: Интеграл sqrt(29 - n·cos^2x) dx от 0 до 5" << endl;

    double a = 0, b = 5;
    double sum_f = 0;

    for (int i = 0; i < N; i++) {
        double x = a + dis(gen) * (b - a);
        sum_f += integr(x);
    }

    double integral = (b - a) / N * sum_f;
    double varian = 0;
    double mean = sum_f / N;
    vector<double> f_vals;
    for (int i = 0; i < N; i++) {
        double x = a + dis(gen) * (b - a);
        double fx = integr(x);
        varian += (fx - mean) * (fx - mean);
    }
    varian /= N;
    double i_error = (b - a) * sqrt(varian / N);

    cout << "Приближённое значение интеграла = " << integral << endl;
    cout << "Абсолютная погрешность: ~" << i_error << endl;
    cout << "Относительная погрешность: ~" << i_error / integral * 100 << "%" << endl << endl;

    cout << "задание 3: Вычисление пи через площадь круга радиуса R = n" << endl;

    double R = n;
    double square_side = 2 * R;
    double square_area = square_side * square_side;

    int M_circle = 0;
    for (int i = 0; i < N; i++) {
        double x = -R + dis(gen) * square_side;
        double y = -R + dis(gen) * square_side;
        if (inCircle(x, y, R)) {
            M_circle++;
        }
    }

    double pi_approx = (double)M_circle / N * 4.0;
    double pi_error_abs = fabs(pi_approx - 3.1415926535);
    double pi_error_rel = pi_error_abs / 3.1415926535 * 100;

    cout << "Приближённое значение pi = " << pi_approx << endl;
    cout << "Точное значение pi = " << 3.1415926535 << endl;
    cout << "Абсолютная погрешность = " << pi_error_abs << endl;
    cout << "Относительная погрешность = " << pi_error_rel << "%" << endl << endl;

    cout << "задание 4: Площадь фигуры p^2 = A·cos^2ф + B·sin^2ф" << endl;

    double A, B;
    if (n >= 11) {
        A = n - 10;  
        B = n - 10;
    }
    else {
        A = 11 + n;
        B = 11 - n;
    }

    cout << "A = " << A << ", B = " << B << endl;

    double max_rho = sqrt(max(A, B));
    double rect_x_min = -max_rho, rect_x_max = max_rho;
    double rect_y_min = -max_rho, rect_y_max = max_rho;
    double rect_area4 = (rect_x_max - rect_x_min) * (rect_y_max - rect_y_min);

    int M4 = 0;
    for (int i = 0; i < N; i++) {
        double x = rect_x_min + dis(gen) * (rect_x_max - rect_x_min);
        double y = rect_y_min + dis(gen) * (rect_y_max - rect_y_min);

        double phi = atan2(y, x);
        double r_calc = sqrt(x * x + y * y);
        double r_boundary = polar(phi, A, B);

        if (r_calc <= r_boundary) {
            M4++;
        }
    }

    double S4 = (double)M4 / N * rect_area4;
    double error4_abs = rect_area4 * sqrt((double)M4 / N * (1 - (double)M4 / N) / N);

    cout << "Площадь фигуры S4 = " << S4 << endl;
    cout << "Попало точек: " << M4 << " из " << N << endl;
    cout << "Абсолютная погрешность: ~" << error4_abs << endl;
    cout << "Относительная погрешность: ~" << error4_abs / S4 * 100 << "%" << endl;

    ofstream fout("monte_carlo_results.txt");
    fout << "Результаты метода Монте-Карло (вариант n=" << n << ")" << endl;
    fout << "Количество точек N=" << N << endl << endl;
    fout << "Задание 1: Площадь = " << S1 << " ± " << error1_abs << endl;
    fout << "Задание 2: Интеграл = " << integral << " ± " << i_error << endl;
    fout << "Задание 3: π ≈ " << pi_approx << " (погрешность " << pi_error_rel << "%)" << endl;
    fout << "Задание 4: Площадь полярной фигуры = " << S4 << " ± " << error4_abs << endl;
    fout.close();

    cout << "\nРезультаты сохранены в файл monte_carlo_results.txt" << endl;
}
