#include <iostream>
#include <random>
#include <cmath>
#include <fstream>
#include <iomanip>
#include <sstream>
#include <string>

using namespace std;

const int n = 12;
const int N = 100000;
const double pi = 3.141592653589793;
const double exact_pi = 3.141592653589793;

string format_number(double value) {
    stringstream ss;
    ss << fixed << setprecision(4) << value;
    string s = ss.str();
    for (char& c : s) {
        if (c == '.') c = ',';
    }
    while (s.back() == '0') s.pop_back();
    if (s.back() == ',') s.pop_back();
    return s;
}

double f1(double x) {
    return 10.0 * x / n;
}

double f2(double x) {
    return (10.0 - x) / (n - 20.0) + 20.0;
}

double integr(double x) {
    return sqrt(29.0 - n * cos(x) * cos(x));
}

double rectangle_method(double (*f)(double), double a, double b, int n) {
    double h = (b - a) / n;
    double sum = 0.0;
    for (int i = 0; i < n; i++) {
        double x = a + i * h + h / 2.0;
        sum += f(x);
    }
    return sum * h;
}

bool inCircle(double x, double y, double R) {
    return (x + R) * (x + R) + (y - R) * (y - R) <= R * R;
}

double polar(double phi, double A, double B) {
    double cos2 = cos(phi) * cos(phi);
    double sin2 = sin(phi) * sin(phi);
    double denom = A * cos2 + B * sin2;
    if (denom <= 0) return 0;
    return sqrt(denom);
}

int main() {
    setlocale(LC_ALL, "rus");

    random_device rd;
    mt19937 gen(rd());
    uniform_real_distribution<> dis(0.0, 1.0);

    cout << "Количество точек N = " << N << endl << endl;
    cout << "    1. Площадь между f1(x) и f2(x)" << endl;

    double x_min = 0, x_max = 30;
    double y_min = 0;
    double y_max = max(f1(x_max), f2(x_max));
    y_max = max(y_max, 20.0);

    double rect_area = (x_max - x_min) * (y_max - y_min);

    cout << "Прямоугольник: [" << x_min << ", " << x_max << "] x [0, " << y_max << "]" << endl;
    cout << "Площадь прямоугольника = " << rect_area << endl;

    int M1 = 0;

    ofstream points1("task1_points.csv");
    points1 << "x;y;status\n";

    for (int i = 0; i < N; i++) {
        double x = x_min + dis(gen) * (x_max - x_min);
        double y = y_min + dis(gen) * (y_max - y_min);

        double low = f1(x);
        double up = f2(x);

        if (y >= low && y <= up) {
            M1++;
            points1 << format_number(x) << ";" << format_number(y) << ";1\n";
        }
        else {
            points1 << format_number(x) << ";" << format_number(y) << ";0\n";
        }
    }
    points1.close();

    ofstream lines1("task1_lines.csv");
    lines1 << "x;f1(x);f2(x)\n";
    for (double x = 0; x <= x_max + 0.01; x += 0.1) {
        lines1 << format_number(x) << ";" << format_number(f1(x)) << ";" << format_number(f2(x)) << "\n";
    }
    lines1.close();

    double S1 = (double)M1 / N * rect_area;
    double p1 = (double)M1 / N;
    double error1_abs = rect_area * sqrt(p1 * (1 - p1) / N);
    double error1_rel = error1_abs / S1 * 100;

    cout << "Попало точек: " << M1 << " из " << N << endl;
    cout << "Площадь фигуры = " << S1 << endl;
    cout << "Абсолютная погрешность = " << error1_abs << endl;
    cout << "Относительная погрешность = " << error1_rel << "%" << endl << endl;

    cout << "    2. Интеграл от 0 до pi/2" << endl;

    double a = 0, b = pi / 2.0;
    double sum_f = 0;

    ofstream func2("task2_function.csv");
    func2 << "x;f(x)\n";
    for (double x = a; x <= b + 0.01; x += 0.01) {
        func2 << format_number(x) << ";" << format_number(integr(x)) << "\n";
    }
    func2.close();

    ofstream points2("task2_points.csv");
    points2 << "x;y;status\n";

    double maxY = 0;
    for (double x = a; x <= b; x += 0.001) {
        maxY = max(maxY, integr(x));
    }
    maxY += 0.5;

    int M2 = 0;
    for (int i = 0; i < N; i++) {
        double x = a + dis(gen) * (b - a);
        double y = dis(gen) * maxY;
        double fx = integr(x);
        sum_f += fx;

        if (y <= fx) {
            M2++;
            points2 << format_number(x) << ";" << format_number(y) << ";1\n";
        }
        else {
            points2 << format_number(x) << ";" << format_number(y) << ";0\n";
        }
    }
    points2.close();

    double integral_mc = (b - a) * sum_f / N;

    int n_exact = 1000;
    double exact_integral = rectangle_method(integr, a, b, n_exact);

    double integral_error_abs = fabs(integral_mc - exact_integral);
    double integral_error_rel = integral_error_abs / exact_integral * 100;

    cout << "Значение интеграла (Монте-Карло) = " << integral_mc << endl;
    cout << "Точное значение (прямоугольники) = " << exact_integral << endl;
    cout << "Абсолютная погрешность = " << integral_error_abs << endl;
    cout << "Относительная погрешность = " << integral_error_rel << "%" << endl << endl;

    cout << "    3. Вычисление pi через круг" << endl;

    double R = n;
    int M_circle = 0;

    ofstream points3("task3_points.csv");
    points3 << "x;y;status\n";

    ofstream circle3("task3_circle.csv");
    circle3 << "x;y\n";
    for (double phi = 0; phi <= 2 * pi + 0.01; phi += 0.05) {
        double x = R * cos(phi);
        double y = R * sin(phi);
        circle3 << format_number(x) << ";" << format_number(y) << "\n";
    }
    circle3.close();

    for (int i = 0; i < N; i++) {
        double x = -R + dis(gen) * (2 * R);
        double y = -R + dis(gen) * (2 * R);
        if (x * x + y * y <= R * R) {
            M_circle++;
            points3 << format_number(x) << ";" << format_number(y) << ";1\n";
        }
        else {
            points3 << format_number(x) << ";" << format_number(y) << ";0\n";
        }
    }
    points3.close();

    double pi_approx = 4.0 * M_circle / N;
    double pi_error_abs = fabs(pi_approx - exact_pi);
    double pi_error_rel = pi_error_abs / exact_pi * 100;

    cout << "Попало точек в круг: " << M_circle << " из " << N << endl;
    cout << "pi = " << pi_approx << endl;
    cout << "Точное pi = " << exact_pi << endl;
    cout << "Абсолютная погрешность = " << pi_error_abs << endl;
    cout << "Относительная погрешность = " << pi_error_rel << "%" << endl << endl;

    cout << "    4. Полярная фигура" << endl;

    double A = n - 10;
    double B = n - 10;
    double max_rho = sqrt(max(A, B));
    double rect_min = -max_rho;
    double rect_max = max_rho;
    double rect_area4 = (rect_max - rect_min) * (rect_max - rect_min);

    int M4 = 0;

    ofstream points4("task4_points.csv");
    points4 << "x;y;status\n";

    ofstream curve4("task4_curve.csv");
    curve4 << "x;y\n";
    for (double phi = 0; phi <= 2 * pi + 0.01; phi += 0.02) {
        double rho = polar(phi, A, B);
        double x = rho * cos(phi);
        double y = rho * sin(phi);
        curve4 << format_number(x) << ";" << format_number(y) << "\n";
    }
    curve4.close();

    for (int i = 0; i < N; i++) {
        double x = rect_min + dis(gen) * (rect_max - rect_min);
        double y = rect_min + dis(gen) * (rect_max - rect_min);
        double phi = atan2(y, x);
        double r_calc = sqrt(x * x + y * y);
        double r_boundary = polar(phi, A, B);
        if (r_calc <= r_boundary) {
            M4++;
            points4 << format_number(x) << ";" << format_number(y) << ";1\n";
        }
        else {
            points4 << format_number(x) << ";" << format_number(y) << ";0\n";
        }
    }
    points4.close();

    double S4 = (double)M4 / N * rect_area4;

    double p4 = (double)M4 / N;
    double error4_abs = rect_area4 * sqrt(p4 * (1 - p4) / N);
    double error4_rel = error4_abs / S4 * 100;

    cout << "Площадь фигуры = " << S4 << endl;
    cout << "Попало точек : " << M4 << endl<<endl;
  //  cout << "Абсолютная погрешность = " << error4_abs << endl;
  //  cout << "Относительная погрешность = " << error4_rel << "%" << endl << endl;
    cout << "Файлы для графиков: task1_points.csv, task1_lines.csv, task2_points.csv," << endl;
    cout << "task2_function.csv, task3_points.csv, task3_circle.csv, task4_points.csv, task4_curve.csv" << endl;
}
