    setlocale(LC_ALL, "Russian");

    double A[4][4] = {
        { 12.14, 1.32, -0.78, -2.75},
        { -0.89, 16.75, 1.88, -1.55},
        { 2.65, -1.27, -15.64, -0.64},
        {2.44, 1.52, 1.93, -11.43}
    };

    double b[4] = { 14.78, -12.14, -11.65, 4.26 };

    double x[4][4] = {
        {0, 0, 0, 0},
        {1, 1, 1, 1},
        {10, -10, 10, -10},
        {100, 100, 100, 100}
    };

    double epsilon = 0.00001;
    int maxIter = 100;

    cout << "Система уравнений:\n";
    cout << "12.14x1 + 1.322 - 0.78x3 - 2.75x4 = 14.78\n";
    cout << "- 0.89x1 + 16.75x2 + 1.88x3 - 1.55x4 = -12.14\n";
