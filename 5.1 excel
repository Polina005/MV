#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>
#include <iomanip>

using namespace std;

double f(double x) {
    return 1.0 / (1.0 + 25.0 * x * x);
}

double lagrange(const vector<double>& x_nodes, const vector<double>& y_nodes, double x) {
    int n = x_nodes.size();
    double result = 0.0;
    for (int i = 0; i < n; i++) {
        double term = y_nodes[i];
        for (int j = 0; j < n; j++) {
            if (j != i) {
                term *= (x - x_nodes[j]) / (x_nodes[i] - x_nodes[j]);
            }
        }
        result += term;
    }
    return result;
}

vector<double> ravnomernye_uzly(int n, double a, double b) {
    vector<double> nodes(n);
    for (int i = 0; i < n; i++) {
        nodes[i] = a + i * (b - a) / (n - 1);
    }
    return nodes;
}

vector<double> chebyshev_uzly(int n, double a, double b) {
    vector<double> nodes(n);
    for (int i = 0; i < n; i++) {
        double t = cos((2.0 * i + 1.0) * 3.141592 / (2.0 * n));
        nodes[i] = (a + b) / 2.0 + (b - a) / 2.0 * t;
    }
    sort(nodes.begin(), nodes.end());
    return nodes;
}

void vyvod_dlya_grafika(int n, bool is_chebyshev, double a, double b, int points = 300) {
    vector<double> uzly;
    if (is_chebyshev) {
        uzly = chebyshev_uzly(n, a, b);
        cout << "# Узлы Чебышева, n = " << n << "\n";
    }
    else {
        uzly = ravnomernye_uzly(n, a, b);
        cout << "# Равномерные узлы, n = " << n << "\n";
    }

    vector<double> znacheniya;
    for (double x : uzly) {
        znacheniya.push_back(f(x));
    }

    cout << "# x          f(x)               Ln(x)\n";
    cout << fixed << setprecision(8);

    for (int i = 0; i <= points; i++) {
        double x = a + i * (b - a) / points;
        cout << x << " " << f(x) << " " << lagrange(uzly, znacheniya, x) << "\n";
    }
    cout << "\n";
}

int main() {
    const double a = -1.0, b = 1.0;
    setlocale(LC_ALL, "Russian");
    vector<int> n_values = { 5, 11, 15 };

    // 1a) Равномерные узлы
    cout << "1a) РАВНОМЕРНЫЕ УЗЛЫ:\n";
    cout << "----------------------------------------\n";
    for (int n : n_values) {
        vyvod_dlya_grafika(n, false, a, b);
    }

    // 1b) Узлы Чебышева
    cout << "1b) УЗЛЫ ЧЕБЫШЕВА:\n";
    cout << "----------------------------------------\n";
    for (int n : n_values) {
        vyvod_dlya_grafika(n, true, a, b);
    }
}
